{
  "model": "StandardScaler + LogisticRegression (multinomial, 3 classes)",
  "features": [
    "landmark",
    "sim_timbre",
    "sim_melody"
  ],
  "feature_meanings": {
    "landmark": "spectral-peak fingerprint match rate (same recording)",
    "sim_timbre": "MFCC sequence sub-sequence DTW similarity (timbre)",
    "sim_melody": "key-invariant Chroma DTW similarity (melody)"
  },
  "training_pairs": 100,
  "class_distribution": {
    "copy": 35,
    "cover": 33,
    "unrelated": 32
  },
  "cross_validation": {
    "scheme": "RepeatedStratifiedKFold(5 splits x 4 repeats, seed=0)",
    "accuracy_mean": 0.6675,
    "accuracy_std": 0.0841,
    "macro_f1_mean": 0.6442
  },
  "in_sample_accuracy_not_for_reporting": 0.68,
  "in_sample_confusion": {
    "labels": [
      "copy",
      "cover",
      "unrelated"
    ],
    "matrix": [
      [
        28,
        6,
        1
      ],
      [
        10,
        12,
        11
      ],
      [
        0,
        4,
        28
      ]
    ]
  },
  "in_sample_per_class": {
    "copy": {
      "precision": 0.7368,
      "recall": 0.8,
      "f1-score": 0.7671,
      "support": 35.0
    },
    "cover": {
      "precision": 0.5455,
      "recall": 0.3636,
      "f1-score": 0.4364,
      "support": 33.0
    },
    "unrelated": {
      "precision": 0.7,
      "recall": 0.875,
      "f1-score": 0.7778,
      "support": 32.0
    }
  },
  "audio_preprocessing": "mono, sr=22050, first 60 seconds",
  "privacy": "Contains model coefficients only. No audio, filenames or IDs.",
  "limitations": [
    "Only 100 labelled pairs from a single source; accuracy varies 0.52-0.88 across 20 different train/test splits (mean ~0.67).",
    "Cover detection is the weakest class (see README / 评测报告.md).",
    "Not suitable for production copyright decisions."
  ],
  "reproduce": "conda activate music && python train_model.py"
}